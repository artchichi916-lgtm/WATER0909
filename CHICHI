function startQuiz(){const n=Math.min(+document.getElementById('count').value, BANK.length-state.mastered.length+state.wrong.length);if(n<=0){alert('全部題目都已答對！');return} const wrong=shuffle(state.wrong.map(id=>BANK[id-1]).filter(Boolean)); const fresh=shuffle(BANK.filter(q=>!state.mastered.includes(q.id)&&!state.wrong.includes(q.id))); current=wrong.slice(0,n); if(current.length<n) current=current.concat(fresh.slice(0,n-current.length)); answers={}; renderQuiz();}
function renderQuiz(){document.getElementById('home').classList.add('hidden');document.getElementById('result').classList.add('hidden');document.getElementById('quiz').classList.remove('hidden');document.getElementById('quizTitle').textContent='本次測驗：'+current.length+' 題';document.getElementById('counter').textContent='尚未作答 0/'+current.length;const box=document.getElementById('questions');box.innerHTML='';current.forEach((q,idx)=>{const card=document.createElement('div');card.className='qcard';card.innerHTML='<div class="qhead"><span>第 '+q.id+' 題</span><span>#'+(idx+1)+'</span></div><div class="qtext">'+esc(q.question)+'</div>'+q.options.map((o,i)=>'<label class="opt"><input type="radio" name="q'+q.id+'" value="'+i+'" onchange="pick('+q.id+','+i+')">('+ (i+1) +') '+esc(o)+'</label>').join('');box.appendChild(card)});updateProgress()}
function pick(id,i){answers[id]=i;updateProgress()}
function updateProgress(){const done=Object.keys(answers).length;document.getElementById('counter').textContent='已作答 '+done+'/'+current.length;document.getElementById('progress').style.width=Math.round(done/current.length*100)+'%'}
function submitQuiz(){if(Object.keys(answers).length<current.length&&!confirm('尚有題目未作答，確定交卷嗎？'))return;let correct=0,wrong=0;const detail=current.map(q=>{const a=answers[q.id];const ok=a===q.answer;if(ok)correct++;else wrong++;if(ok){state.mastered=[...new Set(state.mastered.concat(q.id))];state.wrong=state.wrong.filter(id=>id!==q.id)}else if(!state.wrong.includes(q.id))state.wrong.push(q.id);return{q,a,ok}});state.attempts=state.attempts||[];state.attempts.push({date:new Date().toISOString(),ids:current.map(q=>q.id),correct,wrong});state.last={date:new Date().toISOString(),correct,wrong};save();renderResult(detail)}
function inferTopic(q){const s=q.question+' '+q.options.join(' ');if(/生物急毒性|TUa|LC50|毒性鑑定|毒性減量/.test(s))return'生物急毒性／毒性管理';if(/土壤|地下水監測井|農地肥分|施灌/.test(s))return'土壤處理／地下水';if(/自動監測|電子式電度表|顯示看板|傳輸測試/.test(s))return'自動監測與連線';if(/展延|許可證|水措計畫|核發|申請|補正|技師簽證/.test(s))return'許可申請／展延／審查';if(/試車|功能測試/.test(s))return'試車／功能測試';if(/申報|申報頻率|網路申報|檢測/.test(s))return'檢測申報';if(/納管|污水下水道/.test(s))return'納管／污水下水道';if(/海放管|海洋/.test(s))return'海放管／海洋排放';if(/回收使用|貯留|委託處理|受託處理|稀釋/.test(s))return'水措操作與處理方式';return'其他法規觀念'}
function renderResult(detail){document.getElementById('quiz').classList.add('hidden');const score=Math.round(detail.filter(x=>x.ok).length/detail.length*100);const topic={};detail.filter(x=>!x.ok).forEach(x=>{const t=inferTopic(x.q);topic[t]=(topic[t]||0)+1});const topics=Object.entries(topic).sort((a,b)=>b[1]-a[1]);let analysis=topics.length?topics.slice(0,5).map(([t,c])=>'<div><div><b>'+esc(t)+'</b> <span class="small">'+c+' 題錯誤</span></div><div class="bar"><i style="width:'+Math.min(100,c/detail.length*100*2)+'%"></i></div></div>').join(''):'<p class="good">本次全部答對，保持目前程度即可。</p>';let html='<div class="panel result"><h2>測驗結果</h2><div class="score">'+score+' 分</div><p><span class="good">答對 '+detail.filter(x=>x.ok).length+' 題</span>　<span class="bad">答錯 '+detail.filter(x=>!x.ok).length+' 題</span>　<span class="muted">未作答 '+detail.filter(x=>x.a==null).length+' 題</span></p><div class="analysis-grid"><div><h3>弱項分析</h3>'+analysis+'</div><div><h3>加強建議</h3><p>'+ (topics.length?'優先複習「'+topics[0][0]+'」，接著處理其他錯題分類。再次測驗會優先安排歷史錯題。':'目前沒有明顯弱項，繼續維持。') +'</p><p class="small">答對題會從後續出題池移除；錯題會留在錯題循環中，直到再次答對。</p></div></div></div><div class="panel"><div class="controls"><button class="btn primary" onclick="startQuiz()">再測一次</button><button class="btn secondary" onclick="showReviewBank()">查看錯題</button><button class="btn ghost" onclick="backHome()">回首頁</button></div></div><div class="panel"><h2>逐題檢討</h2>'+detail.map(x=>'<div class="qcard review '+(x.ok?'correct':'wrong')+'"><div class="qhead"><span>第 '+x.q.id+' 題</span><span class="'+(x.ok?'good':'bad')+'">'+(x.ok?'答對':'答錯')+'</span></div><div class="qtext">'+esc(x.q.question)+'</div><div>'+x.q.options.map((o,i)=>'<div class="opt" style="cursor:default;'+(i===x.q.answer?'font-weight:800;text-decoration:underline;':'')+(i===x.a&&!x.ok?'color:var(--bad);':'')+'">('+(i+1)+') '+esc(o)+(i===x.q.answer?'　← 正確答案':'')+(i===x.a&&!x.ok?'　← 你的答案':'')+'</div>').join('')+'</div><div class="answer">正確答案：('+ (x.q.answer+1) +') '+esc(x.q.options[x.q.answer])+'</div></div>').join('')+'</div>';document.getElementById('result').innerHTML=html;document.getElementById('result').classList.remove('hidden')}
function showReviewBank(){document.getElementById('home').classList.add('hidden');document.getElementById('quiz').classList.add('hidden');const list=state.wrong.map(id=>BANK[id-1]).filter(Boolean);document.getElementById('result').innerHTML='<div class="panel result"><h2>錯題庫（'+list.length+' 題）</h2>'+(list.length?list.map(q=>'<div class="qcard review wrong"><div class="qhead"><span>第 '+q.id+' 題</span></div><div class="qtext">'+esc(q.question)+'</div><div class="answer">正確答案：('+ (q.answer+1) +') '+esc(q.options[q.answer])+'</div></div>').join(''):'<p class="good">目前沒有錯題。</p>')+'<div class="controls"><button class="btn primary" onclick="backHome()">回首頁</button></div></div>';document.getElementById('result').classList.remove('hidden')}
function backHome(){document.getElementById('quiz').classList.add('hidden');document.getElementById('result').classList.add('hidden');document.getElementById('home').classList.remove('hidden')}
function exportData(){const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='water-quiz-progress.json';a.click();URL.revokeObjectURL(a.href)}
function importData(e){const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const x=JSON.parse(r.result);if(!Array.isArray(x.mastered)||!Array.isArray(x.wrong))throw new Error('格式');state=x;save();alert('匯入成功')}catch(err){alert('匯入失敗：檔案格式不正確')}};r.readAsText(f)}
function resetAll(){if(confirm('確定清除所有答題紀錄？')){state={mastered:[],wrong:[],attempts:[],last:null};save();alert('已重置')}}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
updateStats();
</script></body></html>
