}.opt:hover{border-color:#93c5fd;background:#eff6ff}.opt input{margin-right:8px}.actions{display:flex;justify-content:space-between;gap:10px;margin-top:18px}.hidden{display:none!important}.result h2{margin-top:0}.score{font-size:48px;font-weight:800}.good{color:var(--good)}.bad{color:var(--bad)}.muted{color:var(--muted)}.review.correct{border-left:6px solid var(--good);background:var(--goodbg)}.review.wrong{border-left:6px solid var(--bad);background:var(--badbg)}.review .answer{font-weight:700}.analysis-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}.tag{display:inline-block;padding:6px 10px;border-radius:999px;background:#eef2ff;color:#3730a3;margin:4px}.bar{height:12px;background:#eef2f7;border-radius:99px;overflow:hidden;margin:6px 0 10px}.bar i{display:block;height:100%;background:var(--bad)}.small{font-size:13px;color:var(--muted)}@media(max-width:780px){.top{flex-direction:column}.stats{grid-template-columns:repeat(2,1fr)}.analysis-grid{grid-template-columns:1fr}.qtext{font-size:16px}.actions{flex-direction:column}.btn{width:100%}}
